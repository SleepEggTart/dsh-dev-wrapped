{
  "name": "dsh-dev-wrapped",
  "version": "1.3.2",
  "description": "Developer Wrapped for DeepSeek Harness — your coding journey with AI, visualized.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-dev-wrapped": "bin/dsh-dev-wrapped.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "wrapped",
    "cli",
    "statistics",
    "report"
  ],
  "optionalDependencies": {
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SleepEggTart/dsh-dev-wrapped.git"
  },
  "bugs": {
    "url": "https://github.com/SleepEggTart/dsh-dev-wrapped/issues"
  },
  "homepage": "https://github.com/SleepEggTart/dsh-dev-wrapped#readme",
  "license": "MIT"
}
